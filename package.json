{
  "name": "kickoff-legends",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Kickoff Legends — a cel-shaded 1v1 head-football game. Plain HTML/CSS/JS + vendored Phaser 3; runs offline. package.json exists only for the tools/ asset pipeline and tests.",
  "scripts": {
    "assets:import": "node tools/import-raw.mjs",
    "assets:build": "node tools/slice-sheet.mjs",
    "assets:preview": "node tools/slice-sheet.mjs --preview",
    "assets:sky": "node tools/sky-split.mjs",
    "assets:icons": "node tools/make-icons.mjs",
    "assets:welcome": "node tools/make-welcome.mjs",
    "audio:build": "node tools/make-audio.mjs",
    "locales:build": "node tools/make-locales.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "npx --yes serve -l 5173 ."
  },
  "devDependencies": {
    "@fontsource/bangers": "^5.1.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "sharp": "^0.33.5"
  }
}
